{
  "name": "appsflyer-capacitor-plugin",
  "version": "7.0.2+1",
  "iosSdkVersion": "7.0.13",
  "iosFrameworkVersion": "7.0.2",
  "androidSdkVersion": "7.0.1",
  "androidPluginBridgeVersion": "7.0.13",
  "buildNumber": "1",
  "description": "AppsFlyer SDK plugin for Capacitor",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "Package.swift",
    "src/",
    "!src/__tests__",
    "package.json",
    "README.md",
    "tsconfig.json",
    "rollup.config.mjs",
    "AppsflyerCapacitorPlugin.podspec"
  ],
  "author": "Dani Koza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppsFlyerSDK/appsflyer-capacitor-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/AppsFlyerSDK/appsflyer-capacitor-plugin/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- autocorrect --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier --plugin=prettier-plugin-java \"**/*.{css,html,ts,js,java}\"",
    "swiftlint": "node-swiftlint",
    "build": "npm run clean && node scripts/gen-version.mjs && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "rimraf": "./node_modules/rimraf/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "node scripts/gen-version.mjs && npm run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@angular/cli": "^12.1.1",
    "@appsflyer-sdk/js-core-plugin": "7.1.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.x",
    "prettier-plugin-java": "^2.x",
    "rimraf": "^6.x",
    "rollup": "^4.x",
    "swiftlint": "^2.0.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@appsflyer-sdk/js-core-plugin": "7.1.0",
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
